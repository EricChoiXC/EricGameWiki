<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wiki.admin.sys.org.model.mapper.OrgUserPasswordLogMapper">

    <resultMap id="logMap" type="com.wiki.admin.sys.org.model.dto.OrgUserPasswordLogDo">
        <id column="field_id" property="fieldId"/>
        <result column="field_user_id" property="fieldUserId"/>
        <result column="field_change_time" property="fieldChangeTime"/>
        <result column="field_new_password" property="fieldNewPassword"/>
    </resultMap>

    <sql id="cols">field_id, field_user_id, field_change_time, field_new_password</sql>

    <select id="selectByUserId" resultMap="logMap">
        SELECT <include refid="cols"/> FROM admin_org_user_password_log
        WHERE field_user_id = #{fieldUserId}
        ORDER BY field_change_time DESC
        LIMIT #{limit}
    </select>

    <insert id="insert">
        INSERT INTO admin_org_user_password_log
        (field_id, field_user_id, field_change_time, field_new_password)
        VALUES
        (#{fieldId}, #{fieldUserId}, #{fieldChangeTime}, #{fieldNewPassword})
    </insert>

</mapper>
